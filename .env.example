# Environment Configuration for Project Management App
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./projectdb.sqlite

# --- Application ---
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
API_VERSION=v1

# --- API Settings ---
APP_TITLE=Project Management API
APP_DESCRIPTION=Tracks 10 concurrent projects with financials, team, and risk data
APP_HOST=127.0.0.1
APP_PORT=8000

# --- AI Chatbot (Google Gemini - free tier) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model name (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
